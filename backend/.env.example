# Copy to .env (local) or set in Render > Environment. Never commit the real values.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fitlog?retryWrites=true&w=majority
JWT_SECRET=replace-this-with-a-long-random-string
PORT=3000
# Google sign-in: the WEB application OAuth client id from Google Cloud Console (same one the app uses)
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Push: paste the entire Firebase service-account JSON on one line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Shown on the public privacy / delete-account pages
CONTACT_EMAIL=your-email@example.com
