# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fitlog?retryWrites=true&w=majority

# Any long, random string — used to sign session tokens (JWT)
JWT_SECRET=replace-this-with-a-long-random-string

# Port Render (or your host) assigns; 3000 is used for local development
PORT=3000
